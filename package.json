{
	"name": "receipt-extractor",
	"description": "Thai convenience-store receipt extractor: OCR, deterministic validation and evals (7-Eleven Thailand first).",
	"private": true,
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"packages/*",
		"evals"
	],
	"scripts": {
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"eval": "bun run evals/run/cli.ts",
		"check": "bun run lint && bun run typecheck && bun test",
		"ocr:setup": "bun run packages/ocr-openthai/scripts/setup.ts",
		"ocr": "bun run packages/ocr-openthai/cli.ts",
		"test:ocr": "OPENTHAI_INTEGRATION=1 bun test packages/ocr-openthai/integration.test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.14"
}
