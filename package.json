{
	"name": "receipt-extractor",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"evals"
	],
	"scripts": {
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"eval": "bun run evals/run/cli.ts",
		"check": "bun run lint && bun run typecheck && bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.14"
}
